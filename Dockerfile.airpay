FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/api
WORKDIR /app
COPY requirements.txt requirements-airpay.txt ./
RUN pip install --no-cache-dir -r requirements-airpay.txt
COPY api ./api
COPY migrations/airpay ./migrations/airpay
CMD ["uvicorn", "hub.airpay_app:app", "--host", "0.0.0.0", "--port", "8011"]
